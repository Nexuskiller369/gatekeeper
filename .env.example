# Copy to .env  (PowerShell:  Copy-Item .env.example .env)
DATABASE_URL="postgresql://gatekeeper:gatekeeper@localhost:5433/gatekeeper?schema=public"
TEST_DATABASE_URL="postgresql://gatekeeper:gatekeeper@localhost:5433/gatekeeper_test?schema=public"
# Any long random string. Never commit the real one.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=3000
